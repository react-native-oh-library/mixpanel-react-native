{
  "name": "@react-native-ohos/mixpanel-react-native",
  "version": "3.2.0",
  "description": "Official React Native Tracking Library for Mixpanel Analytics",
  "files": [
    "src",
    "harmony",
    "javascript",
    "!harmony/oh_modules",
    "!harmony/**/build",
    "!harmony/**/oh_modules"
  ],
  "main": "index.js",
  "scripts": {
    "test": "jest"
  },
  "author": "Mixpanel",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/react-native-oh-library/mixpanel-react-native.git"
  },
  "keywords": [
    "mixpanel",
    "react",
    "native",
    "analytics",
    "tracking",
    "sdk",
    "harmony",
    "react-native"
  ],
  "bugs": {
    "url": "https://github.com/react-native-oh-library/mixpanel-react-native/issues"
  },
  "TODO": "Change the git URL before publishing on npm",
  "homepage": "https://github.com/react-native-oh-library/mixpanel-react-native/tree/br_rnoh0.77#readme",
  "metadata": {
    "mp_lib": "react-native"
  },
  "devDependencies": {
    "@babel/core": "^7.12.3",
    "@babel/runtime": "^7.12.1",
    "@react-native-community/eslint-config": "^2.0.0",
    "babel-jest": "^26.6.0",
    "eslint": "^7.11.0",
    "jest": "^26.6.3",
    "jest-fetch-mock": "^3.0.3",
    "metro-react-native-babel-preset": "^0.63.0",
    "react-native": "0.82.1",
    "react-test-renderer": "19.0.0"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "mixpanel-react-native":"3.1.2"
  },
  "harmony": {
    "alias": "mixpanel-react-native",
    "autolinking": {
      "etsPackageClassName": "MixpanelPackage",
      "cppPackageClassName": "MixpanelPackage",
      "cmakeLibraryTargetName": "rnoh_mixpanel",
      "ohPackageName": "@react-native-ohos/mixpanel-react-native"
    }
  },
  "codegenConfig": {
    "name": "MixpanelTurboModuleSpec",
    "type": "modules",
    "jsSrcsDir": "src"
  },
  "jest": {
    "modulePathIgnorePatterns": [
      "<rootDir>/Samples/"
    ],
    "testMatch": [
      "<rootDir>/__tests__/*.test.js"
    ],
    "setupFiles": [
      "<rootDir>/__tests__/jest_setup.js"
    ],
    "verbose": true,
    "preset": "react-native",
    "transform": {
      "^.+\\.js$": "<rootDir>/node_modules/react-native/jest/preprocessor.js"
    }
  },
  "dependencies": {
    "mixpanel-react-native":"3.1.2",
    "@react-native-async-storage/async-storage": "^1.21.0",
    "react-native-get-random-values": "^1.9.0",
    "uuid": "3.3.2"
  }
}
